    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\n\n// Extract the generated text from the OpenAI response.\nconst recipeText = response.output\n  ?.find(item => item.type === 'message')\n  ?.content\n  ?.find(item => item.type === 'output_text')\n  ?.text;\n\nif (!recipeText) {\n  throw new Error('No recipe text found in the OpenAI response.');\n}\n\n// Remove common Markdown formatting for a cleaner Slack message.\nconst cleanText = recipeText\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '$1')\n  .replace(/^#{1,6}\\s*/gm, '')\n  .replace(/^\\s*---+\\s*$/gm, '')\n  .replace(/[ \\t]+$/gm, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\n// Return both the clean recipe and the original text.\nreturn [{\n  json: {\n    recipe: cleanText,\n    originalRecipe: recipeText\n  }\n}];\n"
      },
